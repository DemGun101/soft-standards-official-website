    {
      "name": "Mobile visibility lesson: Never use `opacity-0 group-hover:opacity-100` as the only way to show inte",
      "type": "decision",
      "properties": {
        "decision_id": "95e23521-1061-43f6-bcc2-133056144d02",
        "project": "notch-version",
        "context": "Mobile visibility lesson: Never use `opacity-0 group-hover:opacity-100` as the only way to show interactive elements like buttons",
        "reasoning": "",
        "full_decision": "Mobile visibility lesson: Never use `opacity-0 group-hover:opacity-100` as the only way to show interactive elements like buttons. On mobile there is no hover state, so elements stay invisible. Always use mobile-first visibility: `opacity-100 sm:opacity-0 sm:group-hover:opacity-100` — visible by default, hidden-until-hover only on desktop. Don't rely on JS touch state either since mobile browsers have sticky CSS :hover that doesn't trigger JS onTouchStart. This came up with the \"Ask AI\" button on service cards in notch-version."
      },
      "id": "f2064dd7-7fd5-4274-873a-4a5cf7e99069",
      "created_at": "2026-02-12T16:05:09.972Z",
