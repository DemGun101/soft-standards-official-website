---

PHASE 5: CUSTOM HOOKS
=====================

file 5.1: hooks/use-scroll-position.js
  purpose: track scroll position
  returns: scrollY, scrollX, scrollDirection
  uses: useEffect with scroll listener
  includes: throttling for performance

file 5.2: hooks/use-mouse-position.js
  purpose: track mouse position
  returns: x, y, normalizedX, normalizedY
  uses: useEffect with mousemove listener
  useful for: parallax, 3d rotation effects

file 5.3: hooks/use-viewport.js
  purpose: responsive breakpoint detection
  returns: width, height, isMobile, isTablet, isDesktop
  uses: useEffect with resize listener
  includes: debouncing

file 5.4: hooks/use-media-query.js
  purpose: single media query check
  parameters: query string
  returns: boolean matches
  uses: matchMedia api

file 5.5: hooks/use-reduced-motion.js
  purpose: accessibility check
  returns: boolean prefersReducedMotion
  uses: prefers-reduced-motion media query
  usage: disable animations if true

file 5.6: hooks/use-intersection.js
  purpose: intersection observer hook
  parameters: options object
  returns: ref, isIntersecting, entry
  useful for: scroll triggered animations

file 5.7: hooks/use-gsap-context.js
  purpose: gsap context management
  returns: contextRef, contextSafe function
  ensures: proper cleanup on unmount

file 5.8: hooks/use-local-storage.js
  purpose: persist state to local storage
  parameters: key, initialValue
  returns: storedValue, setValue
  useful for: theme preference persistence

---

PHASE 6: PROVIDERS
==================

file 6.1: providers/theme-provider.jsx
  purpose: dark and light mode management
  uses: next-themes package
  wraps: entire application
  provides: theme, setTheme, resolvedTheme
  features
    system preference detection
    local storage persistence
    no flash on load

file 6.2: providers/smooth-scroll-provider.jsx
  purpose: gsap smooth scrolling
  uses: gsap ScrollSmoother
  wraps: main content
  provides: smooth scroll instance
  configuration
    smooth: 1.5
    effects: true for parallax
    normalizeScroll: true
  note: only enable on desktop, disable on mobile

file 6.3: providers/animation-provider.jsx
  purpose: global animation context
  uses: framer motion AnimatePresence
  provides: page transition settings
  wraps: children with AnimatePresence
  mode: wait for sequential transitions

file 6.4: providers/index.jsx
  purpose: combine all providers
  exports: single Providers component
  order from outer to inner
    ThemeProvider
    SmoothScrollProvider
    AnimationProvider

