PHASE 4: UTILITY FILES
======================

file 4.1: lib/utils.js
  note: already created by shadcn
  contains: cn function for class merging

file 4.2: lib/gsap-config.js
  purpose: gsap plugin registration and defaults
  contents
    import gsap and plugins
    register ScrollTrigger
    register ScrollSmoother if using
    export configured gsap instance
    export default animation settings object
      duration: 0.8
      ease: power3.out

file 4.3: lib/animation-variants.js
  purpose: framer motion variants library
  contents
    fadeIn variant
      initial: opacity 0
      animate: opacity 1
      exit: opacity 0
    fadeInUp variant
      initial: opacity 0, y 40
      animate: opacity 1, y 0
      exit: opacity 0, y -20
    fadeInDown variant
      initial: opacity 0, y -40
      animate: opacity 1, y 0
    fadeInLeft variant
      initial: opacity 0, x -40
      animate: opacity 1, x 0
    fadeInRight variant
      initial: opacity 0, x 40
      animate: opacity 1, x 0
    staggerContainer variant
      animate: transition staggerChildren 0.1
    scaleIn variant
      initial: opacity 0, scale 0.8
      animate: opacity 1, scale 1
    slideInFromBottom variant
      initial: y 100%
      animate: y 0
    pageTransition variant
      initial: opacity 0
      animate: opacity 1
      exit: opacity 0

file 4.4: lib/constants.js
  purpose: global constants
  contents
    breakpoints object
      sm: 640
      md: 768
      lg: 1024
      xl: 1280
      2xl: 1536
    animation durations
      fast: 0.2
      normal: 0.4
      slow: 0.8
    z-index scale
      dropdown: 50
      sticky: 100
      modal: 200
      tooltip: 300

file 4.5: lib/three-config.js
  purpose: three.js defaults
  contents
    default camera settings
      fov: 75
      near: 0.1
      far: 1000
      position: 0 0 5
    default canvas settings
      dpr: 1 to 2
